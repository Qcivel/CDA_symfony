{% extends 'base.html.twig' %}

{% block title %}{{ user ? user.firstname ~ ' ' ~ user.lastname : 'Utilisateur introuvable' }}{% endblock %}

{% block body %}
<section class="min-h-screen bg-slate-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

        {# Fil d'Ariane / retour #}
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_users') }}"
            class="group inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-blue-600 transition mb-8">
            <span class="transition-transform group-hover:-translate-x-0.5">←</span>
            Retour à la liste
        </a>
        {% endif %}
        {% if user %}
        <article class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-200">

            {# Bandeau + avatar #}
            <div class="h-24 bg-gradient-to-r from-blue-600 to-blue-500"></div>
            <div class="px-6 sm:px-8 pb-8">
                <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
                    <div class="flex items-end gap-4">
                        <div
                            class="-mt-10 flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-blue-600 text-2xl font-semibold text-white ring-4 ring-white">
                            {% if user.icon %}
                            <img src="{{ asset('images/' ~ user.icon) }}" alt="Photo de {{ user.firstname }}"
                                class="h-full w-full object-cover">
                            {% else %}
                            {{ (user.firstname|default(' ')|first ~ user.lastname|default(' ')|first)|upper }}
                            {% endif %}
                        </div>
                        <div class="pt-3">
                            <h1 class="text-2xl font-semibold tracking-tight text-slate-900">
                                {{ user.firstname }} {{ user.lastname }}
                            </h1>
                            <p class="text-sm text-slate-500">Profil utilisateur</p>
                        </div>
                    </div>
                    <span
                        class="inline-flex w-fit items-center rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20">
                        ID #{{ user.id }}
                    </span>
                </div>

                {# Informations #}
                <div class="mt-8 border-t border-slate-200">
                    <dl class="divide-y divide-slate-100">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4 py-4">
                            <dt class="text-sm font-medium text-slate-500">Prénom</dt>
                            <dd class="text-sm text-slate-900 sm:col-span-2">{{ user.firstname }}</dd>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4 py-4">
                            <dt class="text-sm font-medium text-slate-500">Nom</dt>
                            <dd class="text-sm text-slate-900 sm:col-span-2">{{ user.lastname }}</dd>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4 py-4">
                            <dt class="text-sm font-medium text-slate-500">Email</dt>
                            <dd class="text-sm sm:col-span-2">
                                <a href="mailto:{{ user.email }}" class="text-blue-600 hover:underline break-all">{{
                                    user.email }}</a>
                            </dd>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4 py-4">
                            <dt class="text-sm font-medium text-slate-500">Identifiant</dt>
                            <dd class="text-sm text-slate-900 sm:col-span-2">{{ user.id }}</dd>
                        </div>
                    </dl>
                </div>

                {# Actions #}
                {% if is_granted('ROLE_ADMIN') %}
                <div class="mt-6 flex justify-end">
                    <a href="{{ path('app_users') }}"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-blue-600 hover:bg-blue-600 hover:text-white">
                        Retour à la liste
                    </a>
                </div>
                {% endif %}
                {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_user_edit', {id: user.id}) }}" class="btn btn-ghost btn-sm">Modifier</a>
                {% endif %}
            </div>
        </article>
        {% else %}
        <div
            class="flex flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-white py-20 text-center">
            <h2 class="text-lg font-semibold text-slate-900">Utilisateur introuvable</h2>
            <p class="mt-1 mb-6 text-sm text-slate-500">Ce profil n'existe pas ou a été supprimé.</p>
            <a href="{{ path('app_users') }}"
                class="inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 transition">
                Retour à la liste
            </a>
        </div>
        {% endif %}
    </div>
</section>
{% endblock %}