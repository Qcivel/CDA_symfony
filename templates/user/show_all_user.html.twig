{% extends "base.html.twig" %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
    <twig:Alert message="Bienvenue sur le site !" />
    <twig:Alert message="Enregistrement réussi." type="success" />
    <twig:Alert message="Une erreur est survenue." type="danger" />
    <section class="min-h-screen bg-slate-50 py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            {# En-tête #}
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10 pb-6 border-b border-slate-200">
                <div>
                    <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Utilisateurs</h1>
                    <p class="mt-1 text-sm text-slate-500">Gérez et consultez les comptes enregistrés.</p>
                </div>
                {% if users %}
                    <span class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20">
                        {{ users|length }} utilisateur{{ users|length > 1 ? 's' }}
                    </span>
                {% endif %}
            </div>

            {% if users %}
                <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    {# boucler sur la liste des utilisateurs #}
                    {% for user in users %}
                        <article class="group flex flex-col rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200 transition hover:shadow-md hover:ring-blue-300">

                            <div class="flex items-center gap-4 mb-5">
                                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-semibold text-white">
                                    {{ (user.firstname|default(' ')|first ~ user.lastname|default(' ')|first)|upper }}
                                </div>
                                <div class="min-w-0">
                                    <h2 class="truncate text-base font-semibold text-slate-900">
                                        {{ user.firstname }} {{ user.lastname }}
                                    </h2>
                                    <p class="text-xs font-medium text-slate-400">ID #{{ user.id }}</p>
                                </div>
                            </div>

                            <dl class="space-y-2 text-sm mb-6">
                                <div class="flex items-center gap-2 text-slate-600">
                                    <dt class="sr-only">Email</dt>
                                    <svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                                    </svg>
                                    <dd class="truncate">{{ user.email }}</dd>
                                </div>
                            </dl>

                            <a href="{{ path('app_user_id', {id: user.id}) }}"
                               class="mt-auto inline-flex items-center justify-center gap-1 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-blue-600 hover:bg-blue-600 hover:text-white">
                                Voir le profil
                                <span class="transition-transform group-hover:translate-x-0.5">→</span>
                            </a>
                            
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="flex flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-white py-20 text-center">
                    <svg class="h-12 w-12 text-slate-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                    </svg>
                    <h2 class="text-lg font-semibold text-slate-900">Aucun utilisateur</h2>
                    <p class="mt-1 text-sm text-slate-500">La liste est vide pour le moment.</p>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}