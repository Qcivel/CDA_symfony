{% extends 'base.html.twig' %}

{% block title %}{{ book ? book.title : 'Livre introuvable' }}{% endblock %}

{% block body %}
<style>
    @keyframes trip {
        0% {
            filter: hue-rotate(0deg);
        }

        100% {
            filter: hue-rotate(360deg);
        }
    }

    @keyframes wobble {

        0%,
        100% {
            transform: rotate(-2deg) scale(1);
        }

        50% {
            transform: rotate(2deg) scale(1.03);
        }
    }

    .animate-trip {
        animation: trip 6s linear infinite;
    }

    .animate-wobble {
        animation: wobble 4s ease-in-out infinite;
    }
</style>

<section
    class="relative min-h-screen overflow-hidden bg-gradient-to-br from-fuchsia-600 via-purple-700 to-indigo-900 px-4 py-16">

    {# Blobs psychédéliques en arrière-plan #}
    <div class="animate-trip pointer-events-none absolute inset-0">
        <div class="absolute -top-20 -left-20 h-96 w-96 rounded-full bg-pink-500 opacity-60 blur-3xl animate-pulse">
        </div>
        <div
            class="absolute top-1/3 -right-24 h-[28rem] w-[28rem] rounded-full bg-yellow-400 opacity-50 blur-3xl animate-pulse [animation-delay:1s]">
        </div>
        <div
            class="absolute -bottom-24 left-1/4 h-96 w-96 rounded-full bg-cyan-400 opacity-60 blur-3xl animate-pulse [animation-delay:2s]">
        </div>
        <div
            class="absolute top-10 right-1/3 h-40 w-40 rounded-full border-8 border-dashed border-lime-300 opacity-70 animate-[spin_12s_linear_infinite]">
        </div>
    </div>

    <div class="relative max-w-3xl mx-auto">
        {% if book %}
        <a href="{{ path('app_book') }}"
            class="inline-flex items-center text-sm font-bold text-yellow-300 hover:text-lime-300 hover:tracking-widest mb-8 transition-all duration-300">
            ← Retour à la liste
        </a>

        <article
            class="animate-wobble rounded-3xl bg-white/10 backdrop-blur-xl border-4 border-white/30 shadow-[0_0_60px_rgba(236,72,153,0.7)] p-8">
            <h1 class="text-xs uppercase tracking-[0.5em] text-cyan-200 mb-3">✦ Page livre ✦</h1>

            <h2 class="text-sm italic text-yellow-300 mb-2 animate-bounce">Livre n° {{ book.id }}</h2>

            <p
                class="animate-trip text-5xl font-black mb-8 bg-gradient-to-r from-pink-400 via-yellow-300 to-cyan-400 bg-clip-text text-transparent drop-shadow-lg">
                {{ book.title }}
            </p>

            <div
                class="mb-8 rounded-2xl bg-gradient-to-r from-pink-500/30 via-purple-500/30 to-cyan-500/30 p-6 border border-white/20">
                <h3 class="text-sm font-extrabold uppercase tracking-widest text-lime-300 mb-3">🍄 Résumé</h3>
                <p class="text-white/90 leading-relaxed">{{ book.resume }}</p>
            </div>

            <p class="text-xs text-pink-200 border-t border-dashed border-white/30 pt-4">
                ✺ Créé le {{ book.publishAt|date('d/m/Y') }} ✺
            </p>
        </article>

        <div class="mt-12 text-center">
            <a href="{{ path('app_book') }}"
                class="animate-trip inline-block rounded-full bg-gradient-to-r from-pink-500 via-yellow-400 to-cyan-400 px-10 py-3 font-black uppercase tracking-wider text-purple-900 shadow-[0_0_30px_rgba(250,204,21,0.8)] hover:scale-110 hover:rotate-3 transition-transform duration-300">
                Retour à la liste
            </a>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
        <form method="post" action="{{ path('app_book_delete', {id: book.id}) }}"
            onsubmit="return confirm('Supprimer ce livre ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ book.id) }}">
            <button class="btn btn-error">Supprimer</button>
        </form>
        {% endif %}
        {% else %}
        <div
            class="animate-wobble text-center py-20 rounded-3xl bg-white/10 backdrop-blur-xl border-4 border-dashed border-pink-300">
            <h2
                class="animate-trip text-4xl font-black mb-8 bg-gradient-to-r from-pink-400 via-yellow-300 to-cyan-400 bg-clip-text text-transparent">
                Le livre n'existe pas 👁️
            </h2>
            <a href="{{ path('app_book') }}"
                class="animate-trip inline-block rounded-full bg-gradient-to-r from-pink-500 via-yellow-400 to-cyan-400 px-10 py-3 font-black uppercase text-purple-900 hover:scale-110 hover:-rotate-3 transition-transform duration-300">
                Retour à la liste
            </a>
        </div>
        {% endif %}
    </div>
</section>
{% endblock %}