{% extends "base.html.twig" %}

{% block title %}Liste des livres{% endblock %}

{% block body %}
    <style>
        @keyframes trip {
            0%   { filter: hue-rotate(0deg); }
            100% { filter: hue-rotate(360deg); }
        }
        @keyframes wobble {
            0%, 100% { transform: rotate(-2deg) scale(1); }
            50%      { transform: rotate(2deg) scale(1.03); }
        }
        .animate-trip   { animation: trip 6s linear infinite; }
        .animate-wobble { animation: wobble 4s ease-in-out infinite; }
    </style>

    <section class="relative min-h-screen overflow-hidden bg-gradient-to-br from-fuchsia-600 via-purple-700 to-indigo-900 px-4 py-16">

        {# Blobs psychédéliques en arrière-plan #}
        <div class="animate-trip pointer-events-none absolute inset-0">
            <div class="absolute -top-20 -left-20 h-96 w-96 rounded-full bg-pink-500 opacity-60 blur-3xl animate-pulse"></div>
            <div class="absolute top-1/3 -right-24 h-[28rem] w-[28rem] rounded-full bg-yellow-400 opacity-50 blur-3xl animate-pulse [animation-delay:1s]"></div>
            <div class="absolute -bottom-24 left-1/4 h-96 w-96 rounded-full bg-cyan-400 opacity-60 blur-3xl animate-pulse [animation-delay:2s]"></div>
            <div class="absolute top-10 right-1/3 h-40 w-40 rounded-full border-8 border-dashed border-lime-300 opacity-70 animate-[spin_12s_linear_infinite]"></div>
            <div class="absolute bottom-20 left-10 h-24 w-24 rounded-full border-8 border-dotted border-pink-300 opacity-70 animate-[spin_8s_linear_infinite_reverse]"></div>
        </div>

        <div class="relative max-w-6xl mx-auto">
            <h1 class="animate-trip text-center text-6xl font-black uppercase tracking-tight mb-14 bg-gradient-to-r from-pink-400 via-yellow-300 to-cyan-400 bg-clip-text text-transparent drop-shadow-[0_0_25px_rgba(236,72,153,0.8)]">
                ✺ Liste des livres ✺
            </h1>

            {% if books %}
                <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
                    {# boucler sur la liste des livres #}
                    {% for book in books %}
                        <article
                            class="animate-wobble group flex flex-col rounded-3xl bg-white/10 backdrop-blur-xl border-4 border-white/30 p-6 shadow-[0_0_40px_rgba(236,72,153,0.6)] hover:shadow-[0_0_70px_rgba(250,204,21,0.9)] hover:border-yellow-300 transition-all duration-300"
                            style="animation-delay: -{{ loop.index * 0.7 }}s; animation-direction: {{ loop.index is odd ? 'normal' : 'reverse' }};">

                            <h2 class="text-sm italic text-yellow-300 mb-2 group-hover:animate-bounce">
                                Livre n° {{ book.id }}
                            </h2>

                            <p class="animate-trip text-2xl font-black mb-4 bg-gradient-to-r from-pink-400 via-yellow-300 to-cyan-400 bg-clip-text text-transparent">
                                {{ book.title }}
                            </p>

                            <p class="text-white/90 text-sm leading-relaxed mb-4 line-clamp-3 rounded-xl bg-gradient-to-r from-pink-500/20 via-purple-500/20 to-cyan-500/20 p-3 border border-white/20">
                                🍄 {{ book.resume }}
                            </p>

                            <p class="text-xs text-pink-200 border-t border-dashed border-white/30 pt-3 mb-5">
                                ✺ Créé le {{ book.publishAt|date('d/m/Y') }} ✺
                            </p>

                            <a href="{{ path('app_book_id', {id: book.id}) }}"
                               class="animate-trip mt-auto inline-block text-center rounded-full bg-gradient-to-r from-pink-500 via-yellow-400 to-cyan-400 py-2 px-6 font-black uppercase tracking-wider text-purple-900 shadow-[0_0_20px_rgba(250,204,21,0.7)] hover:scale-110 hover:rotate-3 transition-transform duration-300">
                                Détail 👁️
                            </a>
                            {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_book_edit', {id: book.id}) }}"
                               class="btn btn-ghost btn-sm">Modifier</a>
                        {% endif %}
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="animate-wobble max-w-xl mx-auto text-center py-20 rounded-3xl bg-white/10 backdrop-blur-xl border-4 border-dashed border-pink-300">
                    <h2 class="animate-trip text-4xl font-black bg-gradient-to-r from-pink-400 via-yellow-300 to-cyan-400 bg-clip-text text-transparent">
                        La liste est vide 🌀
                    </h2>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}