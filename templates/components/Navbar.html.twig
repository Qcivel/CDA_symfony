{% props %}
<nav class="border-b border-gray-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between px-4 py-3">

        {# Logo / nom du site #}
        <a href="{{ path('app_home') }}" class="text-xl font-bold text-indigo-600">
            MonSite
        </a>

        {# Case à cocher cachée : elle ouvre et ferme le menu sur mobile, sans JavaScript #}
        <input type="checkbox" id="menu-toggle" class="peer hidden">

        {# Bouton burger, visible seulement sur mobile #}
        <label for="menu-toggle"
               class="cursor-pointer rounded-md p-2 text-gray-600 hover:bg-gray-100 md:hidden"
               aria-label="Ouvrir le menu">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </label>

        {# Liens #}
        <ul class="hidden w-full flex-col gap-1 pt-3 peer-checked:flex
                   md:flex md:w-auto md:flex-row md:items-center md:gap-6 md:pt-0">
            <li>
                <a href="/" class="block rounded-md px-3 py-2 text-gray-700 hover:bg-gray-100 hover:text-indigo-600
                                   md:p-0 md:hover:bg-transparent">
                    Home
                </a>
            </li>
            {# Catégories avec sous-menu #}
            {% if app.user %}
            <li class="group relative">
                <a href="{{ path('app_categories') }}"
                   class="flex items-center gap-1 rounded-md px-3 py-2 text-gray-700 hover:bg-gray-100 hover:text-indigo-600
                          md:p-0 md:hover:bg-transparent">
                    Catégories
                    {# Petite flèche, visible seulement sur ordinateur #}
                    <svg class="hidden h-4 w-4 transition-transform md:block md:group-hover:rotate-180"
                         fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                    </svg>
                </a>

                {# Le sous-menu #}
                <div class="md:absolute md:left-0 md:top-full md:z-20 md:hidden md:pt-3
                            md:group-hover:block md:group-focus-within:block">
                    <ul class="flex flex-col pl-4
                               md:min-w-52 md:rounded-md md:border md:border-gray-200 md:bg-white md:py-2 md:pl-0 md:shadow-lg">
                        <li>
                            <a href="{{ path('app_categories') }}"
                               class="block rounded-md px-3 py-2 text-sm text-gray-600 hover:bg-gray-100 hover:text-indigo-600
                                      md:rounded-none">
                                Toutes les catégories
                            </a>
                        </li>
                        {% if is_granted('ROLE_USER') %}
                        <li>
                            <a href="{{ path('app_category_new') }}"
                               class="block rounded-md px-3 py-2 text-sm text-gray-600 hover:bg-gray-100 hover:text-indigo-600
                                      md:rounded-none">
                                Ajouter une catégorie
                            </a>
                        </li>
                        {% endif %}
                    </ul>
                </div>
            </li>
            
            <li>
                <a href="/user" class="block rounded-md px-3 py-2 text-gray-700 hover:bg-gray-100 hover:text-indigo-600
                                   md:p-0 md:hover:bg-transparent">
                    Utilisateur
                </a>
            </li>
            <li>
                <a href="/book" class="block rounded-md px-3 py-2 text-gray-700 hover:bg-gray-100 hover:text-indigo-600
                                   md:p-0 md:hover:bg-transparent">
                    Les livres
                </a>
            </li>
            <li>
                <a href="{{ path('app_book_new')}}" class="block rounded-md px-3 py-2 text-gray-700 hover:bg-gray-100 hover:text-indigo-600
                                   md:p-0 md:hover:bg-transparent">
                    Ajouter un  livres
                </a>
            </li>
            <li>
                <a href="/logout" class="block rounded-md px-3 py-2 text-gray-700 hover:bg-gray-100 hover:text-indigo-600
                                   md:p-0 md:hover:bg-transparent">
                    Déconnexion
                </a>
            </li>
            {%endif%}
            {% if not app.user %}
            <li>
                <a href="/login" class="block rounded-md px-3 py-2 text-gray-700 hover:bg-gray-100 hover:text-indigo-600
                                   md:p-0 md:hover:bg-transparent">
                    Se connecter
                </a>
            </li>
            <li>
                <a href="/register" class="block rounded-md px-3 py-2 text-gray-700 hover:bg-gray-100 hover:text-indigo-600
                                   md:p-0 md:hover:bg-transparent">
                    Créer un compte
                </a>
            </li>
            {%endif%}
        </ul>
    </div>
</nav>
