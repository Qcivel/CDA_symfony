{% props title, steps %}
<div class="card mb-8 border border-base-300 bg-base-200">
    <div class="card-body">
        <h2 class="card-title">{{ title }}</h2>
        <ol class="list-decimal space-y-1 pl-6">
            {% for id, label in steps %}
                <li><a href="#{{ id }}" class="link link-hover">{{ label }}</a></li>
            {% endfor %}
        </ol>
    </div>
</div>
